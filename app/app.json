{
  "expo": {
    "name": "TrainerTrade",
    "slug": "localpoketrades",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.localpoketrades.app"
    },
    "android": {
      "package": "com.localpoketrades.app"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0a1e3c"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to share a photo of a card in chat, e.g. for the other person to inspect before you meet up.",
          "cameraPermission": "Used to take a photo of a card to share in chat, e.g. for the other person to inspect before you meet up."
        }
      ]
    ]
  }
}
