{
  "expo": {
    "name": "localpoketrades",
    "slug": "localpoketrades",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.localpoketrades.app"
    },
    "android": {
      "package": "com.localpoketrades.app"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1a1a2e"
        }
      ]
    ]
  }
}
