PORT=3001
DB_PATH=./data.sqlite
JWT_SECRET=change-me-in-production

# Optional: raises PokemonTCG API rate limits. Works without one for local dev.
# https://dev.pokemontcg.io/
POKEMONTCG_API_KEY=

# OTP delivery for email/phone verification is stubbed in dev: codes are
# logged to the console instead of sent. Wire up a real provider
# (e.g. Twilio for SMS, SendGrid/Postmark for email) before going live —
# see src/services/otp.ts.
